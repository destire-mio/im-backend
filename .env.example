DATABASE_URL=postgres://im:im@localhost:5433/im?sslmode=disable
DATABASE_MAX_CONNECTIONS=10
REDIS_URL=redis://localhost:6379/0
HTTP_ADDR=:8080
METRICS_ADDR=127.0.0.1:9090
# Human-readable prefix only; a random boot ID is appended for every process.
REALTIME_INSTANCE_NAME=im-local
REALTIME_REDIS_NAMESPACE=im:ws
WEBSOCKET_PRESENCE_TTL_SECONDS=30
WEBSOCKET_PRESENCE_RENEW_SECONDS=10
OUTBOX_CONCURRENCY=16
OUTBOX_BATCH_SIZE=64
# Use serial only as the A/B fallback for the previous single-loop execution.
OUTBOX_EXECUTION_MODE=pipeline
# Experimental capacity candidate. Set user_sharded together with 4 workers to
# split Sync projection by user; keep inline/1 until the A/B is accepted.
OUTBOX_PREPARE_MODE=inline
OUTBOX_PREPARE_WORKERS=1
# Use false only as the A/B fallback for per-recipient Presence lookups.
OUTBOX_BATCH_PRESENCE_LOOKUP=true
# Use per_user only as the A/B fallback for the previous implementation.
OUTBOX_PROJECTION_MODE=bulk
# Use recipients or jsonb only as rollback paths for earlier storage formats.
OUTBOX_PROJECTION_STORAGE=sync_events
# Generate once per environment and keep it stable.
# Command: openssl rand -base64 32 | tr -d '\n='
IDEMPOTENCY_KEY=replace-with-unpadded-base64-32-byte-key
IDEMPOTENCY_KEY_VERSION=1
AUTH_RATE_LIMIT_FAIL_OPEN=false
# Only list reverse proxies that delete and rewrite X-Forwarded-For.
TRUSTED_PROXY_CIDRS=
