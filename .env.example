DATABASE_URL=postgres://im:im@localhost:5433/im?sslmode=disable
DATABASE_MAX_CONNECTIONS=10
# 0 shares the API pool. Set a positive value only when Outbox isolation is
# worth the extra PostgreSQL connections and has been calibrated by load test.
OUTBOX_DATABASE_MAX_CONNECTIONS=0
REDIS_URL=redis://localhost:6379/0
HTTP_ADDR=:8080
METRICS_ADDR=127.0.0.1:9090
# Human-readable prefix only; a random boot ID is appended for every process.
REALTIME_INSTANCE_NAME=im-local
REALTIME_REDIS_NAMESPACE=im:ws
WEBSOCKET_PRESENCE_TTL_SECONDS=30
WEBSOCKET_PRESENCE_RENEW_SECONDS=10
OUTBOX_CONCURRENCY=16
OUTBOX_BATCH_SIZE=64
# Message delivery has one implementation: ready v4, pipelined claim/delivery,
# and batch Presence lookup. Only batch size and concurrency are tunable here.
# Generate once per environment and keep it stable.
# Command: openssl rand -base64 32 | tr -d '\n='
IDEMPOTENCY_KEY=replace-with-unpadded-base64-32-byte-key
IDEMPOTENCY_KEY_VERSION=1
# During rotation, keep old version:key pairs here for at least the 10-minute
# idempotency recovery lifetime, then remove them after old records expire.
# Example: IDEMPOTENCY_PREVIOUS_KEYS=1:old-unpadded-base64-key
IDEMPOTENCY_PREVIOUS_KEYS=
AUTH_RATE_LIMIT_FAIL_OPEN=false
# Only list reverse proxies that delete and rewrite X-Forwarded-For.
TRUSTED_PROXY_CIDRS=
